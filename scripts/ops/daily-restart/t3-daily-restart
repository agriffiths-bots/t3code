run_rollback_web_build() {
  local build_sha="$1"
  local package_json="$checkout/apps/web/package.json"
  local script="build"

  # A rollback may check out a release from before build:hosted existed. Keep
  # that first deployment recoverable while retaining the hardened entrypoint
  # for every release that declares it.
  if [[ -f "$package_json" ]] && node -e '
    const pkg = require(process.argv[1]);
    process.exit(Object.hasOwn(pkg.scripts ?? {}, "build:hosted") ? 0 : 1);
  ' "$package_json"; then
    script="build:hosted"
  fi

  run_capture 900 env T3CODE_BUILD_SHA="$build_sha" T3CODE_HOSTED_BUILD=1 \
    pnpm -C "$checkout/apps/web" run "$script"
}


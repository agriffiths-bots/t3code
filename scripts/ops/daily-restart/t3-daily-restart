#!/usr/bin/env bash
set -u

caller_path="${PATH:-}"
PATH="${T3DR_TEST_PATH_PREFIX:+$T3DR_TEST_PATH_PREFIX:}/home/linuxbrew/.linuxbrew/bin:/home/adam/.local/bin:/usr/local/bin:/usr/bin:/bin${caller_path:+:$caller_path}"
export PATH

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

db="${T3DR_DB:-/home/adam/.t3-vps/userdata/state.sqlite}"
attachments_dir="${T3DR_ATTACHMENTS_DIR:-}"
checkout="${T3DR_CHECKOUT:-/home/adam/t3code}"
service="${T3DR_SERVICE:-t3code.service}"
origin="${T3DR_ORIGIN:-http://127.0.0.1:3773}"
snapshot_dir="${T3DR_SNAPSHOT_DIR:-/home/adam/backups/t3-daily}"
ledger="${T3DR_LEDGER:-/home/adam/.openclaw/daily-restart}"
probe_timeout="${T3DR_PROBE_TIMEOUT:-180}"
stop_timeout="${T3DR_STOP_TIMEOUT:-120}"
kill_timeout="${T3DR_KILL_TIMEOUT:-30}"
smoke_instance="${T3DR_SMOKE_INSTANCE:-}"
smoke_model="${T3DR_SMOKE_MODEL:-}"
prebuilt_target="${T3DR_PREBUILT_TARGET:-0}"
rollback_sha="${T3DR_ROLLBACK_SHA:-}"
target_sha_override="${T3DR_TARGET_SHA:-}"
prebuilt_assets_dir="${T3DR_PREBUILT_ASSETS_DIR:-}"
pinned_health_probe_source="${T3DR_PINNED_HEALTH_PROBE:-}"
static_dir="${T3DR_STATIC_DIR:-}"
service_config_dir="${T3DR_SERVICE_CONFIG_DIR:-$HOME/.config/systemd/user}"
static_release_root=""
static_previous_target=""
resume_token_revoke_deferred="${T3DR_DEFER_RESUME_TOKEN_REVOKE:-0}"
# capability: live-rollback-v1

usage() {
  cat >&2 <<'USAGE'
usage: t3-daily-restart [--db PATH] [--checkout PATH] [--service NAME]
                        [--origin URL] [--snapshot-dir DIR] [--ledger DIR]
                        [--attachments-dir DIR]
                        [--probe-timeout SECS]
                        [--smoke-instance INSTANCE] [--smoke-model MODEL]
                        [--rollback-sha SHA] [--target-sha SHA]
                        [--prebuilt-target]
                        [--static-dir PATH]
USAGE
}

require_value() {
  local flag="$1"
  if [[ "$#" -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
    echo "t3-daily-restart: $flag requires a value" >&2
    usage
    exit 2
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --db) require_value "$@"; db="$2"; shift 2 ;;
    --attachments-dir) require_value "$@"; attachments_dir="$2"; shift 2 ;;
    --checkout) require_value "$@"; checkout="$2"; shift 2 ;;
    --service) require_value "$@"; service="$2"; shift 2 ;;
    --origin) require_value "$@"; origin="$2"; shift 2 ;;
    --snapshot-dir) require_value "$@"; snapshot_dir="$2"; shift 2 ;;
    --ledger) require_value "$@"; ledger="$2"; shift 2 ;;
    --probe-timeout) require_value "$@"; probe_timeout="$2"; shift 2 ;;
    --smoke-instance) require_value "$@"; smoke_instance="$2"; shift 2 ;;
    --smoke-model) require_value "$@"; smoke_model="$2"; shift 2 ;;
    --prebuilt-target) prebuilt_target=1; shift ;;
    --static-dir) require_value "$@"; static_dir="$2"; shift 2 ;;
    --rollback-sha) require_value "$@"; rollback_sha="$2"; shift 2 ;;
    --target-sha) require_value "$@"; target_sha_override="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "t3-daily-restart: unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ -z "$db" || -z "$checkout" || -z "$service" || -z "$origin" || -z "$snapshot_dir" || -z "$ledger" ]]; then
  usage
  exit 2
fi
if [[ -z "$attachments_dir" ]]; then
  attachments_dir="$(dirname "$db")/attachments"
fi
if ! [[ "$probe_timeout" =~ ^[0-9]+$ ]]; then
  echo "t3-daily-restart: --probe-timeout must be a positive integer" >&2
  exit 2
fi
probe_timeout="$((10#$probe_timeout))"
if [[ "$probe_timeout" -le 0 ]]; then
  echo "t3-daily-restart: --probe-timeout must be a positive integer" >&2
  exit 2
fi
if ! [[ "$stop_timeout" =~ ^[0-9]+$ ]] || [[ "$((10#$stop_timeout))" -le 0 ]]; then
  echo "t3-daily-restart: T3DR_STOP_TIMEOUT must be a positive integer" >&2
  exit 2
fi
stop_timeout="$((10#$stop_timeout))"
if ! [[ "$kill_timeout" =~ ^[0-9]+$ ]] || [[ "$((10#$kill_timeout))" -le 0 ]]; then
  echo "t3-daily-restart: T3DR_KILL_TIMEOUT must be a positive integer" >&2
  exit 2
fi
kill_timeout="$((10#$kill_timeout))"
if [[ -z "$smoke_instance" ]]; then
  echo "t3-daily-restart: --smoke-instance or T3DR_SMOKE_INSTANCE is required" >&2
  exit 2
fi
if [[ -z "$smoke_model" ]]; then
  echo "t3-daily-restart: --smoke-model or T3DR_SMOKE_MODEL is required" >&2
  exit 2
fi
case "$prebuilt_target" in
  1|true|TRUE|yes|YES) prebuilt_target=1 ;;
  0|false|FALSE|no|NO|"") prebuilt_target=0 ;;
  *)
    echo "t3-daily-restart: T3DR_PREBUILT_TARGET must be boolean" >&2
    exit 2
    ;;
esac
case "$resume_token_revoke_deferred" in
  1|true|TRUE|yes|YES) resume_token_revoke_deferred=1 ;;
  0|false|FALSE|no|NO|"") resume_token_revoke_deferred=0 ;;
  *)
    echo "t3-daily-restart: T3DR_DEFER_RESUME_TOKEN_REVOKE must be boolean" >&2
    exit 2
    ;;
esac
if [[ "$prebuilt_target" == "1" && -z "$rollback_sha" ]]; then
  echo "t3-daily-restart: --rollback-sha or T3DR_ROLLBACK_SHA is required with --prebuilt-target" >&2
  exit 2
fi
if [[ "$prebuilt_target" == "1" && -z "$target_sha_override" ]]; then
  echo "t3-daily-restart: --target-sha or T3DR_TARGET_SHA is required with --prebuilt-target" >&2
  exit 2
fi
if [[ "$prebuilt_target" == "1" && ( -z "$prebuilt_assets_dir" || ! -d "$prebuilt_assets_dir" ) ]]; then
  echo "t3-daily-restart: T3DR_PREBUILT_ASSETS_DIR is required with --prebuilt-target" >&2
  exit 2
fi
if [[ -n "$static_dir" ]]; then
  if [[ ! "$static_dir" =~ ^/[A-Za-z0-9._/@:+-]+$ || ! -L "$static_dir" ]]; then
    echo "t3-daily-restart: --static-dir must be a safe absolute release symlink" >&2
    exit 2
  fi
  static_release_root="$(dirname -- "$static_dir")"
  static_previous_target="$(readlink -f -- "$static_dir")" || {
    echo "t3-daily-restart: --static-dir does not resolve to a release" >&2
    exit 2
  }
  case "$static_previous_target" in
    "$static_release_root"/*) ;;
    *) echo "t3-daily-restart: --static-dir target must stay under its release root" >&2; exit 2 ;;
  esac
  if [[ ! -f "$static_previous_target/index.html" ]]; then
    echo "t3-daily-restart: --static-dir target must contain index.html: $static_previous_target" >&2
    exit 2
  fi
  if [[ ! "$service" =~ ^[A-Za-z0-9_.@:-]+\.service$ ]]; then
    echo "t3-daily-restart: --service must be an explicit safe .service unit with --static-dir" >&2
    exit 2
  fi
fi
if [[ "$prebuilt_target" == "0" && -n "$rollback_sha" &&
  -z "${T3DR_TOKEN:-}" && -z "${T3_TOKEN:-}" ]]; then
  echo "t3-daily-restart: live fallback requires a resume token minted before checkout dependency mutation" >&2
  exit 2
fi

export T3DR_DB="$db" T3DR_CHECKOUT="$checkout" T3DR_SERVICE="$service" T3DR_ORIGIN="$origin"
export T3DR_ATTACHMENTS_DIR="$attachments_dir" T3DR_SNAPSHOT_DIR="$snapshot_dir" T3DR_LEDGER="$ledger"
export T3DR_SMOKE_INSTANCE="$smoke_instance" T3DR_SMOKE_MODEL="$smoke_model"

utc_date="$(date -u +%F)"
run_dir="$ledger/$utc_date"
mkdir -p "$run_dir" "$snapshot_dir"
log_file="$run_dir/t3-daily-restart.log"
result_file="$run_dir/t3-daily-restart.result"
manifest="$run_dir/resume-manifest.json"
pre_stop_manifest="$run_dir/resume-manifest.pre-stop.json"
lock_file="$ledger/t3-daily-restart.lock"
pinned_tools_dir="$run_dir/pinned-tools"
pinned_health_probe=""
pinned_verify_restart=""
pinned_inject_resume=""
pinned_db_restore=""
pre_restart_pid=""
resume_token=""
resume_token_session_id=""
resume_token_dir=""
resume_token_file=""
resume_token_validation_deferred=0
result_recorded=0

exec 9>"$lock_file"
if ! flock -n 9; then
  echo "t3-daily-restart: another run is already active" >&2
  printf '%s RESULT LOCKED service=%s\n' "$(date -u +%FT%TZ)" "$service" >>"$result_file"
  exit 75
fi

log() {
  printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$log_file" >&2
}

ensure_user_bus_env() {
  if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
  fi
  if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$XDG_RUNTIME_DIR/bus" ]]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    export DBUS_SESSION_BUS_ADDRESS
  fi
}

record_result() {
  printf '%s RESULT %s pre_sha=%s target_sha=%s snapshot=%s manifest=%s\n' \
    "$(date -u +%FT%TZ)" "$1" "${pre_sha:-unknown}" "${target_sha:-unknown}" \
    "${snapshot_path:-unknown}" "$manifest" | tee -a "$result_file" >&2
  result_recorded=1
}

resolve_tool() {
  local name="$1"
  if [[ -n "${T3DR_TEST_PATH_PREFIX:-}" && -x "$T3DR_TEST_PATH_PREFIX/$name" ]]; then
    printf '%s/%s\n' "$T3DR_TEST_PATH_PREFIX" "$name"
    return 0
  fi
  if [[ -x "$script_dir/$name" ]]; then
    printf '%s/%s\n' "$script_dir" "$name"
    return 0
  fi
  if [[ -x "$checkout/scripts/ops/daily-restart/$name" ]]; then
    printf '%s/scripts/ops/daily-restart/%s\n' "$checkout" "$name"
    return 0
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  return 1
}

run_capture() {
  local timeout_secs="$1"
  shift
  if [[ "${1:-}" == "systemctl" && "${2:-}" == "--user" ]]; then
    ensure_user_bus_env
  fi
  log "RUN timeout=$timeout_secs $*"
  timeout "$timeout_secs" "$@" >>"$log_file" 2>&1
}

run_output() {
  local timeout_secs="$1"
  shift
  log "RUN_CAPTURE timeout=$timeout_secs $*"
  timeout "$timeout_secs" "$@" 2>>"$log_file"
}

configure_static_release() {
  [[ -n "$static_dir" ]] || return 0
  local current_target
  current_target="$(readlink -f -- "$static_dir")" || return 1
  if [[ "$current_target" != "$static_previous_target" || ! -f "$current_target/index.html" ]]; then
    log "configured static release disappeared before restart: $static_dir"
    return 1
  fi

  local override_dir="$service_config_dir/${service}.d"
  local override_file="$override_dir/20-t3dr-static-release.conf"
  local temp_file="$override_file.tmp.$$"
  mkdir -p "$override_dir" || return 1
  {
    printf '[Service]\n'
    printf 'Environment=T3CODE_STATIC_DIR=%s\n' "$static_dir"
  } >"$temp_file" || {
    rm -f -- "$temp_file"
    return 1
  }
  chmod 600 "$temp_file" || {
    rm -f -- "$temp_file"
    return 1
  }
  mv -fT -- "$temp_file" "$override_file" || {
    rm -f -- "$temp_file"
    return 1
  }
  run_capture 60 systemctl --user daemon-reload || return 1
  log "configured $service to serve immutable web statics from $static_dir"
}

validate_web_release_identity() {
  local release_dir="$1" expected_sha="$2" actual_sha
  [[ -f "$release_dir/index.html" ]] || return 1
  actual_sha="$(node -e '
    try { process.stdout.write(String(require(process.argv[1]).buildSha ?? "")); } catch {}
  ' "$release_dir/build-identity.json" 2>/dev/null)"
  [[ "$actual_sha" == "$expected_sha" ]] || {
    log "static release identity mismatch: actual=${actual_sha:-missing} expected=$expected_sha dir=$release_dir"
    return 1
  }
}

point_static_release() {
  local release_dir="$1" temp_link="$static_dir.tmp.$$"
  rm -f -- "$temp_link" && ln -s -- "$release_dir" "$temp_link" \
    && mv -fT -- "$temp_link" "$static_dir" || {
    rm -f -- "$temp_link"
    return 1
  }
}

publish_static_release() {
  local build_sha="$1" source_dir="$checkout/apps/web/dist"
  local release_parent release_dir current_target previous_temp
  [[ -n "$static_dir" ]] || return 0
  validate_web_release_identity "$source_dir" "$build_sha" || {
    log "refusing to publish invalid static source for $build_sha"
    return 1
  }
  release_parent="$(mktemp -d "$static_release_root/.t3dr-${build_sha:0:12}.XXXXXX")" || return 1
  release_dir="$release_parent/dist"
  mkdir -p "$release_dir" && cp -a "$source_dir/." "$release_dir/" \
    && validate_web_release_identity "$release_dir" "$build_sha" || {
    log "copied static release failed identity validation: $release_dir"
    return 1
  }
  run_capture 120 node "$script_dir/../../assert-web-no-dev-endpoints.ts" --force "$release_dir" || {
    log "copied static release failed dev-endpoint scan: $release_dir"
    return 1
  }
  chmod -R a-w -- "$release_parent" || return 1
  current_target="$(readlink -f -- "$static_dir")" || return 1
  [[ "$current_target" == "$static_previous_target" ]] || {
    log "static release pointer changed concurrently: expected=$static_previous_target actual=$current_target"
    return 1
  }
  previous_temp="$static_release_root/.previous.tmp.$$"
  printf '%s\n' "$static_previous_target" >"$previous_temp" || return 1
  mv -fT -- "$previous_temp" "$static_release_root/previous" || return 1
  point_static_release "$release_dir" || return 1
  log "published static release atomically: $static_dir -> $release_dir"
}

restore_previous_static_release() {
  [[ -n "$static_dir" ]] || return 0
  validate_web_release_identity "$static_previous_target" "$pre_sha" || {
    log "refusing to restore invalid previous static release: $static_previous_target"
    return 1
  }
  point_static_release "$static_previous_target" || return 1
  log "restored previous static release: $static_dir -> $static_previous_target"
}

prune_static_releases() {
  [[ -n "$static_dir" ]] || return 0
  local current previous release
  current="$(readlink -f -- "$static_dir" 2>/dev/null || true)"
  previous="$(cat "$static_release_root/previous" 2>/dev/null || true)"
  while IFS= read -r release; do
    [[ "$release/dist" == "$current" || "$release/dist" == "$previous" ]] && continue
    case "$release" in "$static_release_root"/.t3dr-*) ;; *) continue ;; esac
    log "pruning superseded static release: $release"
    chmod -R u+w -- "$release" 2>/dev/null || return 1
    rm -rf -- "$release" || return 1
  done < <(find "$static_release_root" -mindepth 1 -maxdepth 1 -type d -name '.t3dr-*' -print)
}

service_main_pid() {
  ensure_user_bus_env
  timeout 10 systemctl --user show "$service" -p MainPID --value 2>>"$log_file" |
    tr -d '[:space:]'
}

systemctl_is_inactive_or_failed() {
  local context="$1"
  local output rc
  ensure_user_bus_env
  log "RUN timeout=10 systemctl --user is-active $service"
  output="$(timeout 10 systemctl --user is-active "$service" 2>>"$log_file")"
  rc=$?
  output="${output//$'\n'/ }"
  [[ -n "$output" ]] || output="empty"
  log "$context is-active rc=$rc state=$output"
  [[ "$output" == "inactive" || "$output" == "failed" ]]
}

stop_service_or_escalate() {
  local context="$1"
  log "$context stop begin service=$service timeout=${stop_timeout}s"
  if run_capture "$stop_timeout" systemctl --user stop "$service"; then
    if systemctl_is_inactive_or_failed "$context after stop"; then
      log "$context stop verified inactive"
      return 0
    fi
    log "$context stop returned success but service is not inactive/failed"
  else
    log "$context stop failed or timed out; verifying state before escalation"
    if systemctl_is_inactive_or_failed "$context after stop failure"; then
      log "$context stop failure left service inactive"
      return 0
    fi
  fi

  log "$context escalate SIGTERM via systemctl kill"
  if ! run_capture "$kill_timeout" systemctl --user kill "$service"; then
    log "$context SIGTERM kill command failed"
  fi
  if systemctl_is_inactive_or_failed "$context after SIGTERM"; then
    log "$context SIGTERM verified inactive"
    return 0
  fi

  log "$context escalate SIGKILL via systemctl kill"
  if ! run_capture "$kill_timeout" systemctl --user kill -s SIGKILL "$service"; then
    log "$context SIGKILL kill command failed"
  fi
  if systemctl_is_inactive_or_failed "$context after SIGKILL"; then
    log "$context SIGKILL verified inactive"
    return 0
  fi

  log "$context stop failed; service is still not inactive/failed after escalation"
  return 1
}

json_fill_manifest() {
  local snapshot="$1"
  if [[ ! -s "$manifest" ]]; then
    printf '{}\n' >"$manifest"
  fi
  node - "$manifest" "$pre_sha" "$snapshot" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const [manifestPath, preSha, snapshotPath] = process.argv.slice(2);
const data = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
data.pre_sha = preSha;
data.db_snapshot = snapshotPath;
const tempPath = path.join(path.dirname(manifestPath), `.${path.basename(manifestPath)}.${process.pid}.tmp`);
try {
  fs.writeFileSync(tempPath, `${JSON.stringify(data, null, 2)}\n`, {
    encoding: "utf8",
    flag: "wx",
    mode: 0o600,
  });
  fs.renameSync(tempPath, manifestPath);
} catch (error) {
  try {
    fs.rmSync(tempPath, { force: true });
  } catch {
    // Preserve the original write/rename error.
  }
  throw error;
}
NODE
}

json_validate_manifest() {
  local target="${1:-$manifest}"
  if [[ ! -s "$target" ]]; then
    printf '{}\n' >"$target"
  fi
  node -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$target"
}

capture_active_manifest() {
  local phase="$1"
  shift
  local candidate="$manifest.$phase.$$"
  rm -f -- "$candidate" || {
    log "$phase failed to clear stale capture candidate"
    return 1
  }
  if ! run_capture 300 "$capture_tool" --db "$db" --out "$candidate" "$@"; then
    log "$phase capture-active-threads failed"
    rm -f -- "$candidate"
    return 1
  fi
  if ! json_validate_manifest "$candidate" >>"$log_file" 2>&1; then
    log "$phase capture manifest was not valid JSON"
    rm -f -- "$candidate"
    return 1
  fi
  if ! mv -f -- "$candidate" "$manifest"; then
    log "$phase failed to publish capture manifest"
    rm -f -- "$candidate"
    return 1
  fi
  log "$phase capture_manifest=$manifest"
}

health_is_pass() {
  local probe_file="$1"
  grep -Eq '^CHECK [^ ]+ FAIL( |$)' "$probe_file" && return 1
  grep -Eq '^CHECK systemd PASS( |$)' "$probe_file" || return 1
  grep -Eq '^CHECK http PASS( |$)' "$probe_file" || return 1
  grep -Eq '^CHECK spawn_wake PASS( |$)' "$probe_file"
}

claude_advisory() {
  local probe_file="$1"
  local prompt verdict rc
  if ! command -v claude >/dev/null 2>&1; then
    log "CLAUDE_ADVISORY unavailable"
    return 0
  fi
  prompt=$'Return exactly one token, HEALTHY or UNHEALTHY, for this health-probe output. Any CHECK FAIL is UNHEALTHY. Output:\n'
  verdict="$(timeout 45 claude -p --model claude-sonnet-5 "${prompt}$(cat "$probe_file")" 2>>"$log_file")"
  rc=$?
  verdict="$(tr -dc 'A-Z_-' <<<"$verdict" | head -c 32)"
  if [[ "$rc" -ne 0 || ! "$verdict" =~ ^(HEALTHY|UNHEALTHY)$ ]]; then
    log "CLAUDE_ADVISORY invalid rc=$rc verdict=${verdict:-empty}"
    return 0
  fi
  log "CLAUDE_ADVISORY $verdict"
}

default_resume_token_ttl() {
  printf '%s\n' "${T3DR_RESUME_TOKEN_TTL:-7200s}"
}

server_state_home() {
  local home="${T3CODE_HOME:-}"
  if [[ -n "$home" ]]; then
    printf '%s\n' "$home"
    return 0
  fi
  cd "$(dirname "$db")/.." 2>/dev/null && pwd -P
}

server_entry() {
  if [[ -f "$checkout/apps/server/dist/bin.mjs" ]]; then
    printf '%s\n' "$checkout/apps/server/dist/bin.mjs"
  else
    printf '%s\n' "$checkout/apps/server/src/bin.ts"
  fi
}

mint_resume_token() {
  local home entry json parsed
  home="$(server_state_home)" || return 1
  entry="$(server_entry)" || return 1
  json="$(
    env -u VITE_DEV_SERVER_URL T3CODE_HOME="$home" timeout 30 node "$entry" auth session issue \
      --json \
      --ttl "$(default_resume_token_ttl)" \
      --label daily-restart-resume-injection \
      --subject daily-restart-resume-injection
  )" || return 1
  parsed="$(node -e 'const fs=require("node:fs"); const issued=JSON.parse(fs.readFileSync(0,"utf8")); console.log(issued.token || ""); console.log(issued.sessionId || "");' <<<"$json")" || return 1
  resume_token="$(sed -n '1p' <<<"$parsed")"
  resume_token_session_id="$(sed -n '2p' <<<"$parsed")"
  [[ -n "$resume_token" ]]
}

revoke_resume_session() {
  local session_id="$1"
  local home entry
  [[ -n "$session_id" ]] || return 0
  home="$(server_state_home)" || return 1
  entry="$(server_entry)" || return 1
  env -u VITE_DEV_SERVER_URL T3CODE_HOME="$home" timeout 30 node "$entry" auth session revoke "$session_id" >/dev/null
}

write_resume_token_file() {
  resume_token_dir="$(mktemp -d)" || return 1
  chmod 700 "$resume_token_dir" || return 1
  resume_token_file="$resume_token_dir/token"
  printf '%s' "$resume_token" >"$resume_token_file" || return 1
  chmod 600 "$resume_token_file"
}

validate_resume_token() {
  local output rc
  output="$(timeout 30 node - "$origin" "$resume_token_file" <<'NODE' 2>&1
const fs = require("node:fs");

const [origin, tokenPath] = process.argv.slice(2);
async function main() {
  const token = fs.readFileSync(tokenPath, "utf8");
  const sessionUrl = new URL("/api/auth/session", origin);
  let response;
  try {
    response = await fetch(sessionUrl, {
      headers: { authorization: `Bearer ${token}` },
    });
  } catch (error) {
    console.error(`auth session unreachable: ${error instanceof Error ? error.message : String(error)}`);
    process.exit(2);
  }
  if (!response.ok) {
    const body = await response.text().catch(() => "");
    if ([502, 503, 504].includes(response.status)) {
      console.error(`auth session unavailable HTTP ${response.status}: ${body.slice(0, 300)}`);
      process.exit(2);
    }
    throw new Error(`auth session HTTP ${response.status}: ${body.slice(0, 300)}`);
  }
  const session = await response.json();
  if (session?.authenticated !== true) {
    throw new Error("auth session is not authenticated");
  }
  const scopes = Array.isArray(session.scopes) ? session.scopes : [];
  const requiredScopes = ["orchestration:operate", "orchestration:read"];

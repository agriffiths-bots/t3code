NODE
)
mapfile -t pre_stop_active_thread_ids < <(node - "$pre_stop_manifest" <<'NODE'
const fs = require("node:fs");
const manifest = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
for (const thread of Array.isArray(manifest.threads) ? manifest.threads : []) {
  const threadId = thread?.thread_id;
  const activeTurnId = thread?.active_turn_id;
  if (
    thread?.role === "active" &&
    typeof threadId === "string" &&
    threadId.length > 0 &&
    typeof activeTurnId === "string" &&
    activeTurnId.length > 0
  ) {
    console.log(threadId);
  }
}
NODE
)

if ! pin_health_probe; then
  log "failed to pin pre-update health-probe"
  record_result "FAILED"
  exit 1
fi
if ! pin_inject_resume; then
  log "failed to pin pre-update inject-resume"
  record_result "FAILED"
  exit 1
fi
if ! pin_verify_restart; then
  log "failed to pin pre-update verify-restart"
  record_result "FAILED"
  exit 1
fi
if ! pin_db_restore; then
  log "failed to pin pre-update t3-db-restore"
  record_result "FAILED"
  exit 1
fi
if ! prepare_resume_token; then
  log "failed to prepare resume-injection token"
  record_result "FAILED"
  exit 1
fi

if ! configure_static_release; then
  log "failed to configure static release before shutdown"
  record_result "FAILED"
  exit 1
fi

pre_restart_pid="$(service_main_pid || true)"
if ! [[ "$pre_restart_pid" =~ ^[0-9]+$ ]]; then
  pre_restart_pid=0
fi
log "pre_restart_pid=$pre_restart_pid"

stop_started_at="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"
if ! stop_service_or_escalate "SHUTDOWN"; then
  log "systemctl stop failed"
  record_result "STOP-FAILED"
  exit 1
fi

post_stop_capture_args=(--stopped-since "$stop_started_at" --pending-since "$pre_stop_pending_since")
for message_id in "${pre_stop_pending_message_ids[@]}"; do
  post_stop_capture_args+=(--include-pending-message-id "$message_id")
done
for thread_id in "${pre_stop_active_thread_ids[@]}"; do
  post_stop_capture_args+=(--include-active-thread-id "$thread_id")
done

if ! capture_active_manifest "post-stop" "${post_stop_capture_args[@]}"; then
  log "post-stop capture failed after service stop"
  record_result "FAILED"
  if run_capture 60 systemctl --user start "$service"; then
    log "restarted unchanged service after post-stop capture failure"
    if sanitize_manifest_for_post_stop_capture_failure; then
      inject_resume_manifest || log "failed to inject pre-stop resume after post-stop capture failure"
    else
      log "failed to sanitize fallback manifest after post-stop capture failure"
    fi
  else
    log "failed to restart after post-stop capture failure"
  fi
  exit 1
fi

snapshot_path="$(run_output 600 "$snapshot_tool" --db "$db" --out-dir "$snapshot_dir")"
if [[ "$?" -ne 0 || -z "$snapshot_path" ]]; then
  log "quiesced snapshot failed after stop"
  record_result "SNAPSHOT-FAILED"
  if run_capture 60 systemctl --user start "$service"; then
    inject_resume_manifest || log "failed to inject resume after quiesced snapshot failure"
  else
    log "failed to restart after quiesced snapshot failure"
  fi
  exit 1
fi
log "quiesced_snapshot=$snapshot_path"
if ! json_fill_manifest "$snapshot_path" >>"$log_file" 2>&1; then
  log "failed to write snapshot metadata into capture manifest"
  record_result "FAILED"
  if run_capture 60 systemctl --user start "$service"; then
    inject_resume_manifest || log "failed to inject resume after manifest fill failure"
  else
    log "failed to restart after manifest fill failure"
  fi
  exit 1
fi

updated=0
if [[ "$prebuilt_target" == "1" ]]; then
  log "prebuilt target supplied; applying checkout update and staged assets"
  if ! run_capture 120 git -C "$checkout" merge --ff-only "$target_sha"; then
    log "prebuilt ff-only update failed"
    code_only_rollback "$run_dir/health-probe.after-prebuilt-update" || exit 1
  fi
  if ! promote_prebuilt_assets >>"$log_file" 2>&1; then
    log "prebuilt asset promotion failed"
    code_only_rollback "$run_dir/health-probe.after-prebuilt-assets" || exit 1
  fi
  updated=1
elif [[ "$pre_sha" != "$target_sha" ]]; then
  if ! run_capture 120 git -C "$checkout" merge --ff-only "$target_sha"; then
    log "ff-only update failed"
    rollback "$run_dir/health-probe.after-update" || exit 1
  fi
  if ! run_capture 900 env T3CODE_BUILD_SHA="$target_sha" pnpm -C "$checkout/apps/web" run build:hosted; then
    log "web rebuild failed before restart"
    code_only_rollback "$run_dir/health-probe.after-web-build" || exit 1
  fi
  if ! run_capture 900 env T3CODE_BUILD_SHA="$target_sha" pnpm -C "$checkout" run build:desktop; then
    log "deploy artifact build failed before restart"
    code_only_rollback "$run_dir/health-probe.after-deploy-build" || exit 1
  fi
  resume_token_revoke_deferred=0
  updated=1
else
  log "checkout already at target; skipping rebuilds"
fi

if [[ "$updated" == "1" ]] && ! publish_static_release "$target_sha"; then
  log "static release publication failed before restart"
  code_only_rollback "$run_dir/health-probe.after-static-publication" || exit 1
fi

if ! run_capture 60 systemctl --user start "$service"; then
  log "systemctl start failed"
  rollback "$run_dir/health-probe.after-start" || exit 1
fi

verify_file="$run_dir/verify-restart.after-start"
verify_rc=0
run_verify_restart "$verify_file" || verify_rc=$?
cat "$verify_file" >>"$log_file"
if [[ "$verify_rc" -ne 0 ]]; then
  if [[ "$updated" == "0" ]] && verify_failed_only_server_build_sha "$verify_file"; then
    retry_verify_file="$run_dir/verify-restart.after-legacy-rebuild"
    retry_verify_rc=0
    retry_legacy_unstamped_noop_restart "$retry_verify_file" || retry_verify_rc=$?
    [[ -f "$retry_verify_file" ]] && cat "$retry_verify_file" >>"$log_file"
    verify_rc="$retry_verify_rc"
  fi
fi
if [[ "$verify_rc" -ne 0 ]]; then
  log "restart verification failed; deterministic code+DB rollback"
  rollback "$run_dir/health-probe.after-verify-restart" || exit 1
fi

probe_file="$run_dir/health-probe.after-start"
probe_rc=0
run_health_probe "$probe_file" || probe_rc=$?
cat "$probe_file" >>"$log_file"
claude_advisory "$probe_file"
if [[ "$probe_rc" -ne 0 ]] || ! health_is_pass "$probe_file"; then
  log "health probe failed; deterministic code+DB rollback"
  rollback "$probe_file" || exit 1
fi

if ! inject_resume_manifest; then
  log "inject-resume failed"
  record_result "FAILED"
  exit 1
fi

record_result "OK"
log "END OK"

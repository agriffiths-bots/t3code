rollback() {
  local probe_file="$1"
  log "ROLLBACK begin"
  if ! stop_service_or_escalate "ROLLBACK"; then
    log "ROLLBACK stop failed"
    record_result "ROLLBACK-FAILED"
    return 1
  fi
  if [[ -z "$pinned_db_restore" || ! -x "$pinned_db_restore" ]]; then
    log "ROLLBACK missing pinned t3-db-restore after stopping failed target"
    record_result "ROLLBACK-FAILED"
    return 1
  fi
  run_capture 300 "$pinned_db_restore" --db "$db" --snapshot "$snapshot_path" || {
    log "ROLLBACK db restore failed"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  run_capture 60 git -C "$checkout" checkout "$pre_sha" || {
    log "ROLLBACK git checkout failed after db restore"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  run_capture 900 pnpm -C "$checkout" install --frozen-lockfile --prefer-offline || {
    log "ROLLBACK dependency restore failed after db restore"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  run_rollback_web_build "$pre_sha" || {
    log "ROLLBACK web rebuild failed"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  run_capture 900 env T3CODE_BUILD_SHA="$pre_sha" pnpm -C "$checkout" run build:desktop || {
    log "ROLLBACK deploy artifact rebuild failed"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  restore_previous_static_release || {
    log "ROLLBACK static release restore failed"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  resume_token_revoke_deferred=0
  run_capture 60 systemctl --user start "$service" || {
    log "ROLLBACK start failed"
    record_result "ROLLBACK-FAILED"
    return 1
  }
  rollback_probe_rc=0
  run_health_probe "$probe_file.rollback" || rollback_probe_rc=$?
  cat "$probe_file.rollback" >>"$log_file"
  if [[ "$rollback_probe_rc" -eq 0 ]] && health_is_pass "$probe_file.rollback"; then
    if ! inject_resume_manifest; then
      log "ROLLBACK inject-resume failed"
      record_result "ROLLBACK-FAILED"
      return 1
    fi
    record_result "ROLLBACK-OK"
  else
    record_result "ROLLBACK-FAILED"
    return 1
  fi
  return 1
}


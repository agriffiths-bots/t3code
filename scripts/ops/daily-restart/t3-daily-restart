ensure_resume_token_validated() {
  [[ "$resume_token_validation_deferred" == "1" ]] || return 0
  validate_resume_token || return 1
  resume_token_validation_deferred=0
  log "resume token validated after service recovery"
}

cleanup_resume_token() {
  if [[ -n "$resume_token_session_id" ]]; then
    if [[ "$resume_token_revoke_deferred" == "1" ]]; then
      log "resume token session revocation deferred; leaving short-lived token to expire"
    else
      revoke_resume_session "$resume_token_session_id" || log "failed to revoke minted resume token session"
    fi
    resume_token_session_id=""
  fi
  if [[ -n "$resume_token_dir" ]]; then
    rm -rf -- "$resume_token_dir"
    resume_token_dir=""
    resume_token_file=""
  fi
}

on_exit() {
  local rc=$?
  cleanup_resume_token || true
  prune_static_releases || true
  exit "$rc"
}

on_signal() {
  local signal="$1" rc="$2"
  trap - TERM INT HUP
  log "received $signal; aborting with rc=$rc"
  if [[ "$result_recorded" -eq 0 ]]; then
    record_result "FAILED"
  fi
  exit "$rc"
}


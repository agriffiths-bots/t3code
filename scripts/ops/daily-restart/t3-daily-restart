  log "HEALTH_PROBE tool=$probe"
  timeout "$((probe_timeout * 2 + 60))" "$probe" --origin "$origin" --service "$service" \
    --instance "$smoke_instance" --model "$smoke_model" --timeout "$probe_timeout" \
    >"$probe_file" 2>>"$log_file"

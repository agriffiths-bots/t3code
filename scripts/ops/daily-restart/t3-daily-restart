verify_failed_only_server_build_sha() {
  local verify_file="$1"
  local saw_build_sha_failure=0
  local saw_other_failure=0
  local line

  while IFS= read -r line; do
    case "$line" in
      "CHECK restart FAIL environment descriptor did not include serverBuildSha"*) saw_build_sha_failure=1 ;;
      "CHECK restart FAIL serverBuildSha mismatch:"*) saw_build_sha_failure=1 ;;
      CHECK\ *\ FAIL*) saw_other_failure=1 ;;
    esac
  done <"$verify_file"

  [[ "$saw_build_sha_failure" == "1" && "$saw_other_failure" == "0" ]]
}

retry_legacy_unstamped_noop_restart() {
  local verify_file="$1"

  log "legacy unstamped no-op artifact detected; rebuilding deploy artifact with target build sha"
  if ! stop_service_or_escalate "LEGACY_REBUILD"; then

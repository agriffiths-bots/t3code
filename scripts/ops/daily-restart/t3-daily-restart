sanitize_manifest_for_post_stop_capture_failure() {
  local output
  output="$(node - "$manifest" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");

const manifestPath = process.argv[2];
const data = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
const threads = Array.isArray(data.threads) ? data.threads : [];
let strippedPending = 0;
let droppedPendingOnly = 0;

data.threads = threads.flatMap((thread) => {
  if (!thread || typeof thread !== "object") return [];
  const activeTurnId = thread.active_turn_id;
  if (
    thread.role !== "active" ||
    typeof activeTurnId !== "string" ||
    activeTurnId.length === 0
  ) {
    if (thread.pending_message !== undefined) droppedPendingOnly += 1;
    return [];
  }

  const sanitized = { ...thread };
  if (sanitized.pending_message !== undefined) {
    delete sanitized.pending_message;
    strippedPending += 1;
  }
  return [sanitized];
});

const tempPath = path.join(
  path.dirname(manifestPath),
  `.${path.basename(manifestPath)}.${process.pid}.tmp`,
);
fs.writeFileSync(tempPath, `${JSON.stringify(data, null, 2)}\n`, { mode: 0o600 });
fs.renameSync(tempPath, manifestPath);
console.log(
  `threads=${data.threads.length} stripped_pending=${strippedPending} dropped_pending_only=${droppedPendingOnly}`,
);
NODE
)" || return 1
  log "post-stop capture failure fallback manifest sanitized $output"
}

inject_resume_timeout_seconds() {
  node - "$manifest" <<'NODE'
const fs = require("node:fs");

const manifestPath = process.argv[2];
const data = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
const threads = Array.isArray(data.threads) ? data.threads : [];
const baseTimeoutSeconds = 600;
const perQueuedReplaySeconds = 120;
let queuedReplayThreads = 0;

for (const thread of threads) {
  if (!thread || typeof thread !== "object") continue;
  const activeTurnId = thread.active_turn_id;
  if (
    thread.role === "active" &&
    thread.injected_at === null &&
    typeof activeTurnId === "string" &&
    activeTurnId.length > 0 &&
    thread.pending_message !== undefined
  ) {
    queuedReplayThreads += 1;
  }
}

console.log(baseTimeoutSeconds + queuedReplayThreads * perQueuedReplaySeconds);
NODE
}

inject_resume_manifest() {
  if [[ -z "$pinned_inject_resume" || ! -x "$pinned_inject_resume" ]]; then
    log "missing pinned inject-resume"
    return 1
  fi
  if [[ -z "$resume_token" ]]; then
    log "missing prepared resume token"
    return 1
  fi
  if ! ensure_resume_token_validated; then
    log "deferred resume token validation failed"
    return 1
  fi
  local inject_timeout
  inject_timeout="$(inject_resume_timeout_seconds)" || {
    log "failed to compute inject-resume timeout"
    return 1
  }
  if ! [[ "$inject_timeout" =~ ^[0-9]+$ ]] || [[ "$inject_timeout" -le 0 ]]; then
    log "invalid inject-resume timeout=$inject_timeout"
    return 1
  fi
  log "RUN timeout=$inject_timeout $pinned_inject_resume --origin $origin --manifest $manifest --attachments-dir $attachments_dir"
  T3DR_TOKEN="$resume_token" timeout "$inject_timeout" "$pinned_inject_resume" --origin "$origin" \
    --manifest "$manifest" --attachments-dir "$attachments_dir" >>"$log_file" 2>&1
}

run_health_probe() {
  local probe_file="$1"

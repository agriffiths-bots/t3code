#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="/home/linuxbrew/.linuxbrew/bin:/home/adam/.local/bin:/usr/local/bin:/usr/bin:/bin"
umask 077

DEFAULT_DB="/home/adam/.t3-vps/userdata/state.sqlite"

usage() {
  cat >&2 <<'USAGE'
usage: t3-db-restore --snapshot FILE [--db PATH]

Restores a verified SQLite snapshot. The caller must stop the T3 service first.
USAGE
}

die() {
  echo "t3-db-restore: $*" >&2
  exit 1
}

absolute_path() {
  realpath -m "$1"
}

sqlite_cli_quote() {
  local value="${1//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

snapshot_path=""
db_path="${T3DR_DB:-$DEFAULT_DB}"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --snapshot)
      [[ "$#" -ge 2 ]] || die "--snapshot requires a file"
      snapshot_path="$2"
      shift 2
      ;;
    --db)
      [[ "$#" -ge 2 ]] || die "--db requires a path"
      db_path="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$snapshot_path" ]] || die "--snapshot is required"
command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 not found on PATH"
command -v flock >/dev/null 2>&1 || die "flock not found on PATH"
[[ -f "$snapshot_path" ]] || die "snapshot does not exist: $snapshot_path"
[[ -f "$db_path" ]] || die "database does not exist: $db_path"

snapshot_path="$(absolute_path "$snapshot_path")"
db_path="$(absolute_path "$db_path")"
db_dir="$(dirname "$db_path")"
mkdir -p "$db_dir" || die "failed to create database directory: $db_dir"

if [[ -e "$db_path-wal" || -e "$db_path-shm" ]]; then
  echo "t3-db-restore: warning: WAL/SHM files exist; caller should stop the T3 service before restore" >&2
fi

lock_file="$db_path.t3dr.lock"
exec 9>"$lock_file" || die "failed to open restore lock: $lock_file"
flock 9 || die "failed to acquire restore lock: $lock_file"

integrity="$(sqlite3 "$snapshot_path" 'PRAGMA integrity_check;' 2>&1)" || die "snapshot integrity check failed: $integrity"
[[ "$integrity" == "ok" ]] || die "snapshot integrity check returned: $integrity"

timestamp="$(date -u +%Y%m%d-%H%M%S)"
backup_path="$db_path.before-restore.$timestamp"
wal_backup_path="$backup_path-wal"
shm_backup_path="$backup_path-shm"
if [[ -e "$backup_path" ]]; then
  sleep 1
  timestamp="$(date -u +%Y%m%d-%H%M%S)"
  backup_path="$db_path.before-restore.$timestamp"
  wal_backup_path="$backup_path-wal"
  shm_backup_path="$backup_path-shm"
fi
[[ ! -e "$backup_path" ]] || die "backup path already exists: $backup_path"
[[ ! -e "$wal_backup_path" ]] || die "WAL backup path already exists: $wal_backup_path"
[[ ! -e "$shm_backup_path" ]] || die "SHM backup path already exists: $shm_backup_path"
db_owner="$(stat -c '%u:%g' "$db_path")" || die "failed to stat current database owner"

tmp_db="$db_dir/.restore-$(basename "$db_path").$$"
cleanup() {
  rm -f "$tmp_db"
}
trap cleanup EXIT

rollback_restore() {
  status="$?"
  rm -f "$tmp_db"
  if [[ ! -e "$db_path" && -e "$backup_path" ]]; then
    mv -- "$shm_backup_path" "$db_path-shm" 2>/dev/null || true
    mv -- "$wal_backup_path" "$db_path-wal" 2>/dev/null || true
    mv -- "$backup_path" "$db_path" 2>/dev/null || true
  fi
  exit "$status"
}

if ! sqlite3 "$snapshot_path" <<SQL
.timeout 5000
.backup $(sqlite_cli_quote "$tmp_db")
SQL
then
  die "failed to materialize snapshot for restore"
fi
chmod 600 "$tmp_db" || die "failed to chmod restored database"
if [[ "$(stat -c '%u:%g' "$tmp_db")" != "$db_owner" ]]; then
  chown "$db_owner" "$tmp_db" || die "failed to restore database ownership"
fi
trap rollback_restore EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mv -- "$db_path" "$backup_path" || die "failed to move current database aside"
chmod 600 "$backup_path" || {
  mv -- "$backup_path" "$db_path" 2>/dev/null || true
  die "failed to chmod pre-restore database backup"
}
if [[ -e "$db_path-wal" ]]; then
  mv -- "$db_path-wal" "$wal_backup_path" || {
    mv -- "$backup_path" "$db_path" 2>/dev/null || true
    die "failed to preserve current WAL file"
  }
  chmod 600 "$wal_backup_path" || die "failed to chmod pre-restore WAL backup"
fi
if [[ -e "$db_path-shm" ]]; then
  mv -- "$db_path-shm" "$shm_backup_path" || {
    mv -- "$wal_backup_path" "$db_path-wal" 2>/dev/null || true
    mv -- "$backup_path" "$db_path" 2>/dev/null || true
    die "failed to preserve current SHM file"
  }
  chmod 600 "$shm_backup_path" || die "failed to chmod pre-restore SHM backup"
fi
if ! mv -- "$tmp_db" "$db_path"; then
  mv -- "$shm_backup_path" "$db_path-shm" 2>/dev/null || true
  mv -- "$wal_backup_path" "$db_path-wal" 2>/dev/null || true
  mv -- "$backup_path" "$db_path" 2>/dev/null || true
  die "failed to install restored database"
fi
trap - EXIT
trap - INT
trap - TERM

rm -f -- "$db_path-wal" "$db_path-shm" || die "failed to remove stale WAL/SHM files"

printf '%s\n' "$db_path"

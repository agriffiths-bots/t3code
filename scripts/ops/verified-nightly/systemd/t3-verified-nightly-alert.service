[Unit]
Description=Deliver verified nightly promotion results through wizzo-alert
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/adam/.local/bin:/home/adam/.openclaw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/adam/t3code/scripts/ops/verified-nightly/t3-verified-nightly-alert
TimeoutStartSec=2min
